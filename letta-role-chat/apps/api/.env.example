# ========================================
# Letta Role Chat - 环境变量配置
# ========================================
# 复制此文件为 .env 并填入真实值：
#   cp .env.example .env

# Letta Cloud API
LETTA_BASE_URL=https://api.letta.com
LETTA_API_KEY=your_letta_api_key_here

# Express 服务器
PORT=3001
HOST=0.0.0.0

# 前端代理目标（Vite dev server 用）
VITE_API_TARGET=http://localhost:3001

# MySQL 数据库（必填）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=letta_chat

# TTS 音频临时目录（可选）
# TEMP_AUDIO_DIR=./temp_audio

# TTS Worker API Key（可选）
# WORKER_TTS_API_KEY=your_worker_key_here

# 头像上传目录（可选，默认 ./uploads/avatars）
# AVATAR_DIR=./uploads/avatars

# 翻译功能（可选，Desktop 端剪贴板翻译使用）
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# TRANSLATE_MODEL=gpt-4o-mini
